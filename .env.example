# Copy to .env.local and fill locally. Never use a secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Documentation only; copy the actual values from the Dashboard.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
# Optional SQL connection via Session pooler; no password is stored here.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
